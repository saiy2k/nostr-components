FIRESTORE_PROJECT=
FIRESTORE_DATABASE=(default)
FIRESTORE_ENTRIES_COLLECTION=nostrDirectoryEntries
FIRESTORE_HANDLES_COLLECTION=nostrDirectoryHandles
FIRESTORE_PROJECTION_RUNS_COLLECTION=relayProjectionRuns
FIRESTORE_LIVE_RUNS_COLLECTION=relayLiveListenerRuns
FIRESTORE_EVENTS_COLLECTION=nostrIdentityEvents
FIRESTORE_QUEUE_COLLECTION=nostrProjectionQueue
FIRESTORE_STATE_COLLECTION=relayCrawlerState
FIRESTORE_GAPS_COLLECTION=relayCrawlerGaps
FIRESTORE_HANDLE_WRITE_FAILURES_COLLECTION=nostrDirectoryHandleWriteFailures

# Optional overrides. By default relays are loaded from ./relays.json.
# RELAYS=wss://purplepag.es,wss://relay.damus.io
# RELAYS_FILE=./relays.json
BACKFILL_TIMEOUT_MS=12000
BACKFILL_PAGE_LIMIT=250
BACKFILL_MAX_PAGE_LIMIT=1000
BACKFILL_MAX_PAGES=4
BACKFILL_CACHE_LIMIT=5000
BACKFILL_UNTIL=
BACKFILL_SINCE=0
BACKFILL_RESUME=1
BACKFILL_STATE_PREFIX=backfill

LIVE_DURATION_MS=0
LIVE_FLUSH_LIMIT=25
LIVE_FLUSH_INTERVAL_MS=5000
LIVE_HEARTBEAT_INTERVAL_MS=30000
LIVE_SEEN_CACHE_LIMIT=50000
LIVE_CONNECT_TIMEOUT_MS=15000

PROJECTION_TIMEOUT_MS=12000
PROJECTION_LIMIT=1000
PROJECTION_WRITE_BUDGET=10000
PROJECTION_EXTERNAL_RETRY_MS=900000
PROJECTION_RUN_DEADLINE_MS=3300000
MAX_PROOFS=250
VERIFY_TWEETS=1
CHECK_ZAPS=1
SCAN_X_PROFILES=0
X_PROFILE_MAX=100
X_BEARER_TOKEN=

MAX_PENDING_CLAIMS=20
MAX_INACTIVE_VERIFIED_CLAIMS=10
MAX_REJECTION_TOMBSTONES=100
MAX_RETRY_ATTEMPTS=5
X_MENTION_CHECK_TIMEOUT_MS=5000
BACKFILL_OUT=
