# Use the URL printed by Firebase after deploying listAtlasProfiles.
# Point this at the separate Firebase project used for the live directory backend.
# VITE_ATLAS_API_URL=https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net/listAtlasProfiles

# To use the local Functions emulator instead:
# VITE_ATLAS_API_URL=http://127.0.0.1:5001/YOUR_PROJECT_ID/us-central1/listAtlasProfiles

# Optional comma-separated public relays. At least one must appear in
# backend/relays.json, because only those relays can satisfy claim publication.
# Only secure wss:// root URLs are accepted; the browser uses at most five.
# VITE_DIRECTORY_CLAIM_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
