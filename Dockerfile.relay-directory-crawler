FROM node:22-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --legacy-peer-deps

COPY --chown=node:node scripts/relay-directory-crawler.mjs ./scripts/relay-directory-crawler.mjs
COPY --chown=node:node scripts/relay-directory ./scripts/relay-directory

ENV NODE_ENV=production

USER node
ENTRYPOINT ["node"]
CMD ["scripts/relay-directory/backfill.mjs", "--no-json"]
