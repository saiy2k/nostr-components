{
  "manifest_version": 3,
  "name": "Nostr Like for X",
  "version": "0.7.0",
  "description": "Adds Nostr Like buttons to posts on X.",
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://us-central1-gr-prod.cloudfunctions.net/*",
    "wss://relay.damus.io/*",
    "wss://nostr.wine/*",
    "wss://relay.nostr.net/*",
    "wss://relay.nostr.band/*",
    "wss://nos.lol/*",
    "wss://nostr-pub.wellorder.net/*",
    "wss://relay.getalby.com/*",
    "wss://relay.primal.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": [
        "lib/url.js",
        "lib/storage.js",
        "lib/directory.js",
        "lib/relay-client.js",
        "lib/component-loader.js",
        "lib/dom.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
