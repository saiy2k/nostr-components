{
  "manifest_version": 3,
  "name": "Nostr Like & Zap",
  "version": "0.7.1",
  "description": "Adds Nostr Like and Zap actions to posts on X and YouTube.",
  "incognito": "split",
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://youtube.com/*",
    "https://us-central1-gr-prod.cloudfunctions.net/*",
    "wss://relay.damus.io/*",
    "wss://nostr.wine/*",
    "wss://relay.nostr.net/*",
    "wss://relay.nostr.band/*",
    "wss://nos.lol/*",
    "wss://nostr-pub.wellorder.net/*",
    "wss://relay.getalby.com/*",
    "wss://relay.primal.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "lib/url.js",
        "lib/storage.js",
        "lib/directory.js",
        "lib/relay-client.js",
        "lib/component-loader.js",
        "lib/dom.js",
        "lib/youtube-dom.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
