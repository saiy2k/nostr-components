{
  "manifest_version": 3,
  "name": "Nostr Competency Test - X Like Button",
  "version": "0.2.0",
  "description": "Adds Firestore-backed Nostr identity metadata and Nostr Like reactions to X posts.",
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://us-central1-gr-prod.cloudfunctions.net/*",
    "wss://relay.damus.io/*",
    "wss://nostr.wine/*",
    "wss://relay.nostr.net/*",
    "wss://relay.nostr.band/*",
    "wss://nos.lol/*",
    "wss://nostr-pub.wellorder.net/*",
    "wss://relay.getalby.com/*",
    "wss://relay.primal.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": [
        "lib/url.js",
        "lib/storage.js",
        "lib/directory.js",
        "lib/relay-client.js",
        "lib/component-loader.js",
        "lib/dom.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["verified-directory.json"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ]
}
