{
  "manifest_version": 3,
  "name": "Nostr Competency Test - X Like Button",
  "version": "0.2.0",
  "description": "Adds Firestore-backed Nostr identity metadata and Nostr Like reactions to X posts.",
  "permissions": ["storage"],
  "host_permissions": ["https://us-central1-gr-prod.cloudfunctions.net/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": [
        "lib/url.js",
        "lib/storage.js",
        "lib/directory.js",
        "lib/bridge-client.js",
        "lib/relay-pool.js",
        "lib/reactions.js",
        "lib/dom.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js", "verified-directory.json"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ]
}
