# Use the URL printed by Firebase after deploying listDirectoryProfiles.
# Point this at the separate Firebase project used for the live directory backend.
# VITE_DIRECTORY_API_URL=https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net/listDirectoryProfiles

# To use the local Functions emulator instead:
# VITE_DIRECTORY_API_URL=http://127.0.0.1:5001/YOUR_PROJECT_ID/us-central1/listDirectoryProfiles
